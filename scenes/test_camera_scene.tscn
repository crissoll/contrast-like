[gd_scene format=3 uid="uid://c2sd4uc3h0iv5"]

[ext_resource type="PackedScene" uid="uid://ban2uu5v1g3uv" path="res://scenes/player/player.tscn" id="1_8qguc"]

[sub_resource type="GDScript" id="GDScript_u25ut"]
script/source = "extends Node3D

@onready 
var camera_system: CompCameraHandler = $\"../CameraSystem\"
@onready 
var player: CharacterBody3D = $\"..\"

@export
var move_speed : float = 100.0


func _physics_process(delta: float) -> void:
	var move_vector := Input.get_vector(
		&\"move_left\",
		&\"move_right\",
		&\"move_forward\",
		&\"move_backward\"
	)
	player.velocity = move_speed * (
		move_vector.x * camera_system.basis.x +
	 	move_vector.y * camera_system.basis.z * Vector3(1,0,1)
	)
	player.move_and_slide()
"

